# ─── LLM Provider 設定 ───────────────────────────
# 選擇要用哪一家: openai (如 OpenCode, OpenRouter) / google / anthropic
LLM_PROVIDER=openai

# ─── OpenCode Zen (預設) ────────────────────────
# 註冊並取得 API Key：https://opencode.ai
OPENAI_API_KEY=sk-...
LLM_BACKEND_URL=https://opencode.ai/zen/v1

# OpenCode 模型選擇 (例如 big-pickle)：
DEEP_THINK_MODEL=big-pickle
QUICK_THINK_MODEL=big-pickle

# ─── 備用機制 (Fallback) ──────────────
FALLBACK_LLM_PROVIDER=openai
FALLBACK_DEEP_THINK_MODEL=nemotron-3-ultra-free
FALLBACK_QUICK_THINK_MODEL=nemotron-3-ultra-free

# ─── Google AI Studio (備用選項) ─────────────────
# FALLBACK_LLM_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
# FALLBACK_DEEP_THINK_MODEL=gemini-2.5-flash
# FALLBACK_QUICK_THINK_MODEL=gemini-2.5-flash

# ─── 其他設定 ────────────────────────────────────
LLM_TEMPERATURE=0.7
